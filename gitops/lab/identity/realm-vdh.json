    {
     "config": {
      "access.token.claim": "true",
      "claim.name": "roles",
      "id.token.claim": "true",
      "jsonType.label": "String",
      "multivalued": "true",
      "userinfo.token.claim": "true"
     },
     "name": "roles",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-usermodel-realm-role-mapper"
    }
   ],
   "publicClient": true,
   "redirectUris": [
    "https://cloud.${ring_domain:=lab.vdh.test}/",
    "https://cloud.${ring_domain:=lab.vdh.test}/oidc-callback.html",
    "https://cloud.${ring_domain:=lab.vdh.test}/oidc-silent-redirect.html"
   ],
   "serviceAccountsEnabled": false,
   "standardFlowEnabled": true,
   "webOrigins": [
    "https://cloud.${ring_domain:=lab.vdh.test}"
   ]
  },
  {
   "attributes": {
    "pkce.code.challenge.method": "S256"
   },
   "clientId": "OpenCloudDesktop",
   "directAccessGrantsEnabled": false,
   "enabled": true,
   "implicitFlowEnabled": false,
   "name": "OpenCloud desktop",
   "protocol": "openid-connect",
   "protocolMappers": [
    {
     "config": {
      "access.token.claim": "true",
      "claim.name": "roles",
      "id.token.claim": "true",
      "jsonType.label": "String",
      "multivalued": "true",
      "userinfo.token.claim": "true"
     },
     "name": "roles",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-usermodel-realm-role-mapper"
    }
   ],
   "publicClient": true,
   "redirectUris": [
    "http://127.0.0.1/*",
    "http://localhost/*"
   ],
   "serviceAccountsEnabled": false,
   "standardFlowEnabled": true
  },
  {
   "attributes": {
    "pkce.code.challenge.method": "S256"
   },
   "clientAuthenticatorType": "client-secret",
   "clientId": "synapse",
