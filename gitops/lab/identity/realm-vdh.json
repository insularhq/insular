{
 "accessTokenLifespan": 300,
 "authenticationFlows": [
  {
   "alias": "vdh-passkey",
   "authenticationExecutions": [
    {
     "authenticator": "auth-cookie",
     "authenticatorFlow": false,
     "priority": 10,
     "requirement": "ALTERNATIVE",
     "userSetupAllowed": false
    },
    {
     "authenticatorFlow": true,
     "flowAlias": "vdh-passkey forms",
     "priority": 20,
     "requirement": "ALTERNATIVE",
     "userSetupAllowed": false
    }
   ],
   "builtIn": false,
   "description": "username, then a passkey; no password",
   "providerId": "basic-flow",
   "topLevel": true
  },
  {
   "alias": "vdh-passkey forms",
   "authenticationExecutions": [
    {
     "authenticator": "auth-username-form",
     "authenticatorFlow": false,
     "priority": 10,
     "requirement": "REQUIRED",
     "userSetupAllowed": false
    },
    {
     "authenticator": "webauthn-authenticator-passwordless",
     "authenticatorFlow": false,
     "priority": 20,
     "requirement": "REQUIRED",
     "userSetupAllowed": false
    }
   ],
   "builtIn": false,
   "description": "username and passkey",
   "providerId": "basic-flow",
   "topLevel": false
  },
  {
   "alias": "vdh-enrol",
   "authenticationExecutions": [
    {
     "authenticator": "auth-username-password-form",
     "authenticatorFlow": false,
     "priority": 10,
     "requirement": "REQUIRED",
     "userSetupAllowed": false
    }
   ],
   "builtIn": false,
   "description": "one-time enrolment: the enrolment password, then register a passkey",
   "providerId": "basic-flow",
   "topLevel": true
  },
  {
   "alias": "vdh-partner-first-login",
   "authenticationExecutions": [
    {
     "authenticator": "idp-create-user-if-unique",
     "authenticatorFlow": false,
     "priority": 10,
     "requirement": "REQUIRED",
     "userSetupAllowed": false
    }
   ],
   "builtIn": false,
   "description": "a partner's user: created under the partner's prefix, never linked",
   "providerId": "basic-flow",
   "topLevel": true
  }
 ],
 "browserFlow": "vdh-passkey",
 "bruteForceProtected": true,
 "clients": [
  {
   "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://pharos.${ring_domain:=lab.vdh.test}/*"
   },
   "clientAuthenticatorType": "client-secret",
   "clientId": "pharos",
   "directAccessGrantsEnabled": false,
   "enabled": true,
   "frontchannelLogout": true,
   "implicitFlowEnabled": false,
   "name": "Insular Pharos",
   "protocol": "openid-connect",
   "protocolMappers": [
    {
     "config": {
      "access.token.claim": "true",
      "id.token.claim": "false",
      "included.client.audience": "pharos"
     },
     "name": "audience-pharos",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-audience-mapper"
    }
   ],
   "publicClient": false,
   "redirectUris": [
    "https://pharos.${ring_domain:=lab.vdh.test}/oauth2/callback",
    "https://netbox.${ring_domain:=lab.vdh.test}/oauth2/callback"
   ],
   "serviceAccountsEnabled": false,
   "standardFlowEnabled": true,
   "webOrigins": [
    "https://pharos.${ring_domain:=lab.vdh.test}"
   ]
  },
  {
   "attributes": {
    "backchannel.logout.session.required": "true",
    "backchannel.logout.url": "https://cloud.${ring_domain:=lab.vdh.test}/backchannel_logout",
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://cloud.${ring_domain:=lab.vdh.test}/*"
   },
   "clientId": "opencloud-web",
   "directAccessGrantsEnabled": false,
   "enabled": true,
   "frontchannelLogout": false,
   "implicitFlowEnabled": false,
   "name": "OpenCloud web",
   "protocol": "openid-connect",
